 "turns": [
  {
   "turn_id": 0,
   "speaker": "user",
   "time": "2026-07-06 19:10",
   "text": "Went a little overboard shopping this weekend... want the damage report?",
   "images": []
  },
  {
   "turn_id": 1,
   "speaker": "assistant",
   "time": "2026-07-06 19:11",
   "text": "Always. Walk me through it.",
   "images": []
  },
  {
   "turn_id": 2,
   "speaker": "user",
   "time": "2026-07-06 19:12",
   "text": "Here's the same thing twice, split only by the pattern — and the first one wins easily.",
